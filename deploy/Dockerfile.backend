# Verified official multi-architecture manifest, 2026-10-27.
FROM python:3.11.18-slim-bookworm@sha256:90d117a7f1ef6535dc75831e1a9184725757fede0d4d424d7977fb5429d50610
ARG TARGETARCH
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 PIP_NO_CACHE_DIR=1 \
    DATA_DIR=/data SEPARATION_MODEL_DIR=/models/umxhq FFMPEG_BINARY=/usr/bin/ffmpeg \
    BASIC_PITCH_RUNTIME=onnx NUMBA_CACHE_DIR=/tmp/numba MPLCONFIGDIR=/tmp/matplotlib \
    XDG_CACHE_HOME=/tmp/cache OMP_NUM_THREADS=2 OPENBLAS_NUM_THREADS=2
# System packages receive current Debian security fixes when deliberately rebuilding.
RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg libsndfile1 libgomp1 ca-certificates fonts-dejavu-core fonts-liberation \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid 10001 scorecraft && useradd --uid 10001 --gid 10001 --create-home scorecraft \
    && mkdir -p /app /data/.scratch /data/.request-spool /models/umxhq \
    && chmod 700 /data/.scratch /data/.request-spool \
    && chown -R 10001:10001 /app /data /models
WORKDIR /app
COPY deploy/requirements-linux-*.lock.txt ./deploy/
# Linux-specific, fully resolved hashes include upstream-required TensorFlow,
# while inference still selects ONNX. Torch URLs are CPU-only author wheels.
RUN case "$TARGETARCH" in amd64|arm64) ;; *) exit 1 ;; esac \
    && python -m pip install --require-hashes --only-binary=:all: \
       -r "deploy/requirements-linux-${TARGETARCH}.lock.txt" \
    && python -m pip check
COPY backend ./backend
COPY deploy ./deploy
USER 10001:10001
CMD ["python", "-m", "uvicorn", "backend.app.main:app", "--host", "0.0.0.0", "--port", "8000", "--proxy-headers", "--forwarded-allow-ips", "172.30.67.2", "--no-access-log", "--limit-concurrency", "32", "--timeout-keep-alive", "5"]
