# Copy to deploy/.env (ignored). No passwords or session secrets belong here.
# A provisioned account is created interactively with the admin CLI.
APP_DOMAIN=score.example.com
ACME_EMAIL=operator@example.com
MAX_UPLOAD_BYTES=500000000
MAX_DURATION_SECONDS=3600
MAX_PROJECTS_PER_USER=100
MAX_STORAGE_MB_PER_USER=32768
MAX_ACTIVE_JOBS_PER_USER=3
MAX_JOBS_PER_DAY=30
API_RATE_LIMIT_PER_MINUTE=300
WRITE_RATE_LIMIT_PER_MINUTE=60
LOGIN_RATE_LIMIT_PER_MINUTE=10
SESSION_TTL_SECONDS=28800
MAX_JOB_ATTEMPTS=3
JOB_TIMEOUT_SECONDS=7200
SEPARATION_TIMEOUT_SECONDS=14400
SEPARATION_MEMORY_MB=4096
MAX_SEPARATION_STORAGE_MB=16384
SEPARATION_THREADS=2
SEPARATION_SEGMENT_SECONDS=10
SEPARATION_OVERLAP=0.25
PDF_TIMEOUT_SECONDS=120
PDF_MEMORY_MB=1024

# Durable resumable transfers: bounded chunks and automatic idle expiry.
UPLOAD_CHUNK_BYTES=8388608
UPLOAD_TTL_SECONDS=86400
MAX_ACTIVE_UPLOADS_PER_USER=3
UPLOAD_CHUNK_RATE_LIMIT_PER_MINUTE=120
