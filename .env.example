# Copy to .env in the repository root. API and worker must share this file.
# Relative paths are resolved against the repository root, not the shell cwd.
DATA_DIR=.data
MAX_UPLOAD_BYTES=500000000
MAX_DURATION_SECONDS=3600

# Install FFmpeg separately. May be an absolute path to your local binary.
FFMPEG_BINARY=ffmpeg

# Select Spotify's bundled ONNX model explicitly.
BASIC_PITCH_RUNTIME=onnx

# Bound decoding separately from model inference.
DECODE_TIMEOUT_SECONDS=600
DECODE_CPU_SECONDS=300
# Hard address-space limit on Linux. macOS uses per-allocation/thread/output caps.
DECODE_MEMORY_MB=512
# Selected clips whose peak AND RMS stay below this floor are rejected as silent.
SILENCE_THRESHOLD_DBFS=-70

# Durable attempt budget, including recovery and user retries.
MAX_JOB_ATTEMPTS=3
JOB_TIMEOUT_SECONDS=7200
# Saved per project; optional upload controls can override within validated bounds.
MINIMUM_NOTE_SECONDS=0.08
MERGE_GAP_SECONDS=0.03

# Native headless Verovio engraving; install backend/requirements-engraving.txt.
PDF_TIMEOUT_SECONDS=120
# Hard address-space limit on Linux only. All platforms bound XML/pages/output/time.
PDF_MEMORY_MB=1024

# Mixed recordings: install the separately licensed separation engine and weights.
SEPARATION_MODEL_DIR=.data/models/umxhq
SEPARATION_SEGMENT_SECONDS=10
SEPARATION_OVERLAP=0.25
SEPARATION_THREADS=2
SEPARATION_TIMEOUT_SECONDS=14400
# Peak resident memory is monitored in the isolated analysis process.
SEPARATION_MEMORY_MB=4096
# Per mixed project: source, attempt output, and copied child-stem inputs.
MAX_SEPARATION_STORAGE_MB=16384

# Local remains loopback-only and anonymous by default. Hosted requires HTTPS/auth.
APP_MODE=local
AUTH_ENABLED=false
# Set to the exact HTTPS origin in hosted mode (no trailing slash).
# PUBLIC_ORIGIN=https://score.example.com
SESSION_TTL_SECONDS=28800
API_RATE_LIMIT_PER_MINUTE=300
WRITE_RATE_LIMIT_PER_MINUTE=60
LOGIN_RATE_LIMIT_PER_MINUTE=10
# Enforced when authentication is enabled; include retries and selected parts.
MAX_PROJECTS_PER_USER=100
MAX_STORAGE_MB_PER_USER=32768
MAX_ACTIVE_JOBS_PER_USER=3
MAX_JOBS_PER_DAY=30

# Durable resumable transfers: bounded chunks and automatic idle expiry.
UPLOAD_CHUNK_BYTES=8388608
UPLOAD_TTL_SECONDS=86400
MAX_ACTIVE_UPLOADS_PER_USER=3
UPLOAD_CHUNK_RATE_LIMIT_PER_MINUTE=120
